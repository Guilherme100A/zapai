# Copie para .env e preencha. Uso pessoal / local — sem camada de seguranca
# por decisao de escopo (spec.md 28).

# Postgres do docker-compose (porta propria, nao colide com outro Postgres)
DATABASE_URL=postgres://zapai:zapai@localhost:55432/zapai

# Chaves de IA — basta UMA. Cada bloco de IA pode sobrescrever a chave e o modelo.
# Sem nenhuma chave o bloco de IA ainda funciona no modo "Local — sem chave (teste)".
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=gpt-4o-mini

# WhatsApp
WHATSAPP_PROVIDER=baileys
WHATSAPP_SESSION_DIR=./.wa-sessions

# App
APP_PORT=3737
TZ=America/Sao_Paulo
